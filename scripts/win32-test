#!/bin/bash
# Run the test suite on a real Windows machine.
#
# This is not a test *selector* -- `uv run pytest` works on Windows and running
# it is one line of this script. What the script is for is everything around
# that: getting the code onto a machine with no shared filesystem, and the
# podman-on-WSL bookkeeping. There is no Windows CI job, so the loop is manual.
#
# The working tree is synced, not a commit, which is the point: this is a dev
# loop, so uncommitted changes are what you want to test.
#
# Host defaults to the `win11` ssh alias; override with WIN32_HOST=<alias>.
#
# One-time setup on that host:
#     ssh <host> "cd pf-win32-test && uv sync --all-groups"
# The oracle unit tests alone need only pytest, but the e2e tests start a real
# uvicorn -- and `pf`'s own runtime deps include no fastapi/uvicorn, so a bare
# `pip install pytest` is not enough for those.
#
# With no arguments pytest uses its configured `testpaths`. Pass a narrower
# target to override, e.g.  scripts/win32-test tests/test_ssh_win32.py
#
# `-o addopts=` is unconditional, not just a default: the repo's addopts turns
# on xdist, and none of these tests want it. The oracle tests need no
# parallelism (each anchors on a process it spawns itself, so nothing
# collides), and the e2e tests would be actively harmed -- the podman fixture is
# session-scoped per worker, so N workers means N sshd containers.
set -euo pipefail
cd "$(dirname "$0")/.."

host=${WIN32_HOST:-win11}
remote=${WIN32_REMOTE_DIR:-pf-win32-test}
target=${*:-}

echo "== syncing to $host:$remote"
# tar over ssh rather than rsync: Windows 10+ ships bsdtar as tar.exe, but not
# rsync. --exclude keeps __pycache__ from shadowing with Linux-built bytecode.
#
# The whole project, not just src/provablyfine: the sshd container image uses
# the repo root as its build context and copies in pyproject.toml, README.md,
# LICENSE.md, src/ and packages/provablyfine-client (see `_containerfile()` in
# tests/conftest.py), so a narrower sync fails at the first COPY. The `sshd_image`
# fixture builds it from this synced tree on Windows exactly as it does
# everywhere else, so the scope has to cover it. bin/ is skipped -- it holds a
# 17MB Linux frpc binary that is both gitignored and unusable there.
#
# The synced directories are removed first because tar only ever adds: a file
# deleted here lingers on the VM forever otherwise, and a stale test file that
# no longer exists in the repo still gets collected and run. Only these four
# are touched -- .venv and the pytest temp dirs live elsewhere.
ssh "$host" "if not exist $remote mkdir $remote"
ssh "$host" "cd $remote & (for %d in (packages src tests scripts) do @if exist %d rmdir /s /q %d)"
#
# .containerignore has to travel with the tree: podman reads it from the build
# context's own directory, so without it the sshd image build on the VM ships
# the whole 250MB working copy (.venv and all) instead of the five paths the
# Containerfile actually copies -- slow, and prone to "archive/tar: write too long" when
# a file in the tree grows while the context is being tarred.
tar czf - --exclude='__pycache__' --exclude='*.pyc' \
    --exclude='src/provablyfine/bin' \
    .containerignore pyproject.toml uv.lock README.md LICENSE.md packages src tests scripts \
    | ssh "$host" "tar xzf - -C $remote"

echo "== running"
# Three pieces of podman-on-WSL bookkeeping, all needed, all learned the hard
# way on the VM:
#
# 1. The machine is started only when `podman info` says it is not already up.
#    `podman machine start` against a *running* machine does not no-op: it
#    "detects a port conflict", reassigns the machine's ssh port, and leaves
#    the previous forwarder stranded, so every client afterwards fails with
#    "connection refused" on the old port. Repeated starts are what wedged
#    this VM, not any one of them.
#
# 2. It shares this one ssh invocation with pytest. WSL tears the machine's
#    distro down once the session that started it ends, so starting it in a
#    separate ssh call leaves nothing running by the time the tests look.
#
# 3. The keepalive. Starting the machine is not enough: WSL also terminates an
#    idle distro after about a minute, *including one with a running
#    container*. Without this the sshd container vanishes mid-test and the
#    symptom is a baffling "connect to host 127.0.0.1 port NNNNN: Connection
#    refused" from ssh, long after the fixture verified that very port. A
#    detached `sleep` holds a client attached; it expires on its own, so a
#    leftover only keeps the machine warm.
ssh "$host" "cd $remote & (podman info > nul 2>&1 || podman machine start) & \
    start /b wsl -d podman-machine-default --exec sleep 3600 & \
    uv run --no-sync python -m pytest -o addopts= $target"
