[14.977212, "o", "\ufffd\ufffd\u2500\u2500\u2500\u001b[0m\u001b[38;2;0;255;0;48;2;18;18;18m\u2510\u001b[0m\r\n\u001b[12;1H\u001b[38;2;0;255;0;48;2;18;18;18m\u2502\u001b[0m\u001b[12;2H\u001b[1;38;2;224;224;224;48;2;36;47;56m Type \u001b[0m\u001b[1;38;2;224;224;224;48;2;36;47;56m Filter \u001b[0m\u001b[1;38;2;224;224;224;48;2;36;47;56m Permissions \u001b[0m\u001b[1;38;2;224;224;224;48;2;36;47;56m                                                                       \u001b[0m\u001b[12;100H\u001b[38;2;0;255;0;48;2;18;18;18m\u2502\u001b[0m\r\n\u001b[13;1H\u001b[38;2;0;255;0;48;2;18;18;18m\u2502\u001b[0m\u001b[13;2H\u001b[38;2;224;224;224;48;2;18;18;18mNo grants \u2014 add one with 'a'\u001b[0m\u001b[13;30H\u001b[48;2;18;18;18m                                                                      \u001b[0m\u001b[38;2;0;255;0;48;2;18;18;18m\u2502\u001b[0m\r\n\u001b[14;1H\u001b[38;2;0;255;0;48;2;18;18;18m\u2514\u001b[0m\u001b[38;2;0;255;0;48;2;18;18;18m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[38;2;0;255;0;48;2;18;18;18m\u2518\u001b[0m\u001b[1;1H"]
